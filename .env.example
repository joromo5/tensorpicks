# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5

# Slack
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL=general

# Twitter/X (for Business Finder agent)
TWITTER_BEARER_TOKEN=your-bearer-token

# Google Maps (for Local Outreach agent)
GOOGLE_MAPS_API_KEY=your-api-key

# Gmail SMTP (for Local Outreach agent)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Outreach settings
OUTREACH_LOCATION=Austin, TX
OUTREACH_SENDER_NAME=Your Name
OUTREACH_SENDER_BUSINESS=Your Web Design Co
OUTREACH_AUTO_SEND=false

# Content Creator (requires ComfyUI running locally)
SLACK_APP_TOKEN=xapp-your-app-token
COMFYUI_URL=http://localhost:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
PIPER_VOICE_MODEL=en_US-lessac-medium
MUSICGEN_MODEL=facebook/musicgen-small

# Crypto Trader
CRYPTO_PAPER_BALANCE=100.0
CRYPTO_TRADING_MODE=paper

# Sports Bettor
THE_ODDS_API_KEY=your-odds-api-key
SPORTS_BETTOR_BET_SIZE=10.0
SPORTS_BETTOR_MIN_EV=3.0
SPORTS_BETTOR_BANKROLL=1000.0
OPENWEATHER_API_KEY=your-openweather-key

# Schedules (cron expressions)
BUSINESS_FINDER_SCHEDULE=0 8 * * *
LOCAL_OUTREACH_SCHEDULE=0 9 * * 1
CRYPTO_TRADER_SCHEDULE=0 */4 * * *
SPORTS_BETTOR_SCHEDULE=0 9 * * *
